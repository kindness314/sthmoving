.modal-root,
.modal-mask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.modal-root {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.modal-mask {
  z-index: 0;
  background: rgba(17, 24, 39, 0.52);
}

.modal-card {
  position: relative;
  z-index: 1;
  width: 100%;
  max-height: 82vh;
  padding: 32rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(15, 23, 42, 0.2);
}

.modal-title {
  margin-bottom: 24rpx;
  color: #111827;
  font-size: 36rpx;
  font-weight: 700;
  text-align: left;
}

.modal-input {
  display: block;
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d7dee8;
  border-radius: 14rpx;
  background: #f8fafc;
  box-sizing: border-box;
  color: #111827;
  font-size: 30rpx;
}

.modal-input:focus {
  border-color: var(--brand-color, #17365d);
  background: #ffffff;
}

.picker-body {
  margin-top: 20rpx;
  min-height: 200rpx;
}

.picker-hint {
  padding: 60rpx 0;
  color: #9ca3af;
  font-size: 26rpx;
  text-align: center;
}

.picker-error {
  color: #b91c1c;
}

.picker-retry {
  margin-left: 16rpx;
  color: var(--brand-color, #17365d);
  text-decoration: underline;
}

.picker-list {
  max-height: 480rpx;
}

.picker-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #eef2f7;
  color: #111827;
  font-size: 30rpx;
}

.picker-item:active {
  background: #f1f5f9;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.modal-actions button {
  flex: 1;
  min-width: 0;
  margin: 0;
}
