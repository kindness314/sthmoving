<view class="page">
  <view class="heading">
    <view class="title">查询物品</view>
    <view class="muted">按名称、详情、编码或分类查找</view>
  </view>

  <view class="card search-card">
    <input
      class="search-input"
      type="text"
      maxlength="100"
      value="{{keyword}}"
      placeholder="输入物品名称、详情或编码"
      confirm-type="search"
      bindinput="handleKeywordInput"
      bindconfirm="handleSearchConfirm"
    />
    <picker
      mode="selector"
      range="{{categoryNames}}"
      value="{{categoryIndex}}"
      bindchange="handleCategoryChange"
    >
      <view class="category-picker">
        <text>{{categoryNames[categoryIndex]}}</text>
        <text class="picker-arrow">⌄</text>
      </view>
    </picker>
  </view>

  <view wx:if="{{loading}}" class="state muted">正在加载物品…</view>
  <view
    wx:elif="{{errorMessage && !items.length}}"
    class="card state"
  >
    <view class="error">{{errorMessage}}</view>
    <button class="retry-button" size="mini" bindtap="handleRetry">
      重新加载
    </button>
  </view>
  <view wx:elif="{{!items.length}}" class="card state muted">
    没有找到符合条件的物品
  </view>

  <view
    wx:for="{{items}}"
    wx:key="id"
    class="card item-card"
    data-id="{{item.id}}"
    bindtap="handleItemTap"
  >
    <image
      wx:if="{{item.coverImage}}"
      class="cover"
      src="{{item.coverImage}}"
      mode="aspectFill"
    />
    <view wx:else class="cover placeholder">暂无图片</view>
    <view class="item-main">
      <view class="item-heading">
        <view class="item-name">{{item.name}}</view>
        <view
          class="status {{item.status === 'OUTBOUND_PENDING' ? 'pending' : ''}}"
        >
          {{item.statusText}}
        </view>
      </view>
      <view class="description muted">
        {{item.description || '暂无详情'}}
      </view>
      <view class="meta">
        <text>{{item.category.name}}</text>
        <text>{{item.quantityText}}</text>
      </view>
      <view class="updated muted">更新于 {{item.updatedAtText}}</view>
    </view>
  </view>

  <view wx:if="{{loadingMore}}" class="state muted">正在加载更多…</view>
  <view
    wx:if="{{errorMessage && items.length}}"
    class="load-more-error error"
  >
    {{errorMessage}}
  </view>
  <view
    wx:if="{{items.length && !nextCursor && !loading}}"
    class="state muted"
  >
    已显示全部物品
  </view>
</view>
