.heading {
  margin-bottom: 28rpx;
}

.title {
  margin-bottom: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.search-card {
  margin-bottom: 28rpx;
  padding: 24rpx;
}

.filter-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
  padding: 24rpx;
}

.filter-card .category-picker {
  flex: 1;
  justify-content: flex-start;
  gap: 16rpx;
  margin-top: 0;
}

.filter-clear {
  color: #b91c1c;
  font-size: 26rpx;
}

.search-field {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 80rpx;
  padding: 0 22rpx;
  border: 1rpx solid #d7dee8;
  border-radius: 14rpx;
  background: #f8fafc;
}

.search-icon {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  margin-right: 16rpx;
}

.search-input {
  min-width: 0;
  flex: 1;
  height: 78rpx;
  line-height: 80rpx;
}

.category-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  height: 80rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d7dee8;
  border-radius: 14rpx;
  background: #f8fafc;
}

.picker-arrow {
  width: 14rpx;
  height: 14rpx;
  margin-right: 6rpx;
  border-right: 3rpx solid #9ca3af;
  border-bottom: 3rpx solid #9ca3af;
  transform: translateY(-4rpx) rotate(45deg);
}

.item-card {
  display: flex;
  margin-bottom: 20rpx;
  padding: 24rpx;
  transition: opacity 120ms ease, transform 120ms ease;
}

.item-card-active {
  opacity: 0.84;
  transform: scale(0.992);
}

.select-box {
  flex: none;
  margin: 72rpx 16rpx 0 0;
}

.cover {
  flex: none;
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 24rpx;
}

.item-main {
  min-width: 0;
  flex: 1;
  margin-left: 24rpx;
}

.item-heading,
.meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.item-name {
  overflow: hidden;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  flex: none;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--brand-soft-color, #e8eef6);
  color: var(--brand-color, #17365d);
  font-size: 22rpx;
}

.status.pending {
  background: #fef3c7;
  color: #92400e;
}

.status.off-shelf {
  background: #f3f4f6;
  color: #6b7280;
}

.description {
  display: -webkit-box;
  overflow: hidden;
  margin: 14rpx 0;
  font-size: 26rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.meta {
  color: #374151;
  font-size: 25rpx;
}

.updated {
  margin-top: 12rpx;
  font-size: 23rpx;
}

.state {
  padding: 48rpx 24rpx;
  line-height: 1.6;
  text-align: center;
}

.error,
.load-more-error {
  color: #b91c1c;
  font-size: 26rpx;
  text-align: center;
}

.retry-button {
  margin-top: 20rpx;
}

.load-more-error {
  padding: 20rpx;
}

.management-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.management-button {
  width: 280rpx;
}

.management-hint {
  align-self: flex-start;
  font-size: 24rpx;
  line-height: 1.5;
}

.batch-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx 20rpx;
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
}

.batch-bar > text {
  flex: 0 0 100%;
  line-height: 1.5;
}

.batch-bar button {
  flex: 1;
  min-width: 0;
}

.refreshing {
  margin: -8rpx 0 16rpx;
  font-size: 24rpx;
  text-align: right;
}

