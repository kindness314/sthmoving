.heading {
  margin-bottom: 32rpx;
}

.title {
  margin-bottom: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.section {
  margin-bottom: 24rpx;
}

.field-label {
  margin-bottom: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.field-help {
  margin-top: -6rpx;
  margin-bottom: 20rpx;
  font-size: 23rpx;
}

.spaced-label {
  margin-top: 28rpx;
}

.text-input,
.picker-field {
  box-sizing: border-box;
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 16rpx;
  background: #ffffff;
  line-height: 80rpx;
}

.text-area,
.summary-area {
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx 24rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 16rpx;
}

.text-area {
  min-height: 200rpx;
}

.summary-area {
  min-height: 140rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item,
.add-image {
  box-sizing: border-box;
  width: 200rpx;
}

.preview-image {
  display: block;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
}

.remove-image {
  width: 100%;
  margin: 12rpx 0 0;
  color: #b91c1c !important;
}

.add-image {
  height: 200rpx;
  margin: 0;
  border: 2rpx dashed #94a3b8;
  background: #f8fafc !important;
  color: #475569 !important;
  font-size: 27rpx;
  line-height: 196rpx;
}

.radio-group {
  display: flex;
  gap: 48rpx;
}

.radio-option {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.category-create-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.category-input {
  flex: 1;
  min-width: 0;
}

.category-button {
  flex: none;
  margin: 0;
  color: #0f766e !important;
}

.error {
  margin: 8rpx 0 24rpx;
  color: #b91c1c;
  font-size: 26rpx;
}

.submit-button {
  margin-top: 32rpx;
}
