.home-page {
  --page-inset-top: 32rpx;
  padding-top: 32rpx;
  padding-bottom: calc(180rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 44rpx;
}

.heading {
  min-width: 0;
  flex: 1;
  margin-bottom: 0;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
  color: var(--brand-color, #17365d);
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.eyebrow-mark {
  width: 32rpx;
  height: 7rpx;
  background: var(--brand-color, #17365d);
}

.title {
  margin-bottom: 10rpx;
  color: #17211f;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.home-header .muted {
  font-size: 30rpx;
}

.grid {
  display: grid;
  gap: 20rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.shortcut-group + .shortcut-group {
  margin-top: 48rpx;
}

.group-heading {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.group-title {
  flex: none;
  color: #33413e;
  font-size: 27rpx;
  font-weight: 700;
}

.group-divider {
  flex: 1;
  height: 1rpx;
  background: #dce4ee;
}

.shortcut {
  box-sizing: border-box;
  min-height: 224rpx;
  padding: 26rpx;
  transition: transform 120ms ease, opacity 120ms ease;
}

.shortcut-active {
  opacity: 0.82;
  transform: scale(0.98);
}

.shortcut-top-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 68rpx;
}

.shortcut-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  background: var(--brand-soft-color, #e8eef6);
}

.shortcut-icon {
  width: 36rpx;
  height: 36rpx;
}

.shortcut-title {
  margin-top: 20rpx;
  color: #17211f;
  font-size: 32rpx;
  font-weight: 600;
}

.shortcut-badge {
  min-width: 34rpx;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  background: #b91c1c;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
}

.shortcut-description {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.45;
}
