<view class="page home-page" style="{{themeStyle}}">
  <nav-bar title="共享仓库" show-back="{{false}}" show-home="{{false}}" />
  <view class="home-header">
    <view class="heading">
      <view class="eyebrow">
        <view class="eyebrow-mark"></view>
        <text>YUNA 个物终端</text>
      </view>
      <view class="title">仓库工作台</view>
      <view class="muted">
        {{userName ? userName + '，欢迎回来' : '正在确认身份'}}
      </view>
    </view>
  </view>
  <view
    wx:for="{{shortcutGroups}}"
    wx:key="key"
    wx:for-item="group"
    class="shortcut-group"
  >
    <view class="group-heading">
      <view class="group-title">{{group.title}}</view>
      <view class="group-divider"></view>
    </view>
    <view class="grid">
      <view
        wx:for="{{group.shortcuts}}"
        wx:key="key"
        wx:for-item="shortcut"
        class="card shortcut"
        data-key="{{shortcut.key}}"
        bindtap="handleShortcut"
        hover-class="shortcut-active"
        hover-stay-time="80"
      >
        <view class="shortcut-top-row">
          <view class="shortcut-icon-wrap">
            <image class="shortcut-icon" src="{{shortcut.icon}}" mode="aspectFit" />
          </view>
          <view wx:if="{{shortcut.badge}}" class="shortcut-badge">
            {{shortcut.badge}}
          </view>
        </view>
        <view class="shortcut-title">{{shortcut.title}}</view>
        <view class="muted shortcut-description">
          {{shortcut.description}}
        </view>
      </view>
    </view>
  </view>
</view>
