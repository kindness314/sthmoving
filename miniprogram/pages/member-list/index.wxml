<view class="page" style="{{themeStyle}}">
  <nav-bar title="成员管理" />
  <view class="heading">
    <view class="title">成员管理</view>
    <view class="muted">管理成员、管理员与实际管理者</view>
  </view>
  <view wx:if="{{loading && !members.length}}" class="state muted">正在加载成员…</view>
  <view wx:elif="{{errorMessage && !members.length}}" class="card state">
    <view class="error">{{errorMessage}}</view>
    <button size="mini" class="retry-button" bindtap="loadMembers">重新加载</button>
  </view>
  <view wx:elif="{{!members.length}}" class="card state muted">暂无成员</view>

  <view wx:if="{{currentRole === 'OWNER' && !hasManager}}" class="card setup-notice">
    尚未任命实际管理者，请从已通过审核的管理员中任命首位实际管理者。
  </view>

  <view wx:for="{{members}}" wx:key="id" class="card member-card">
    <view class="member-heading">
      <view class="member-name">{{item.displayName}}</view>
      <view class="role role-{{item.role}}">{{item.roleText}}</view>
    </view>
    <view class="muted meta">状态：{{item.statusText}}</view>
    <view
      wx:if="{{item.status === 'APPROVED' && ((item.role === 'MEMBER' && (currentRole === 'ADMIN' || currentRole === 'MANAGER' || currentRole === 'OWNER')) || (item.role === 'ADMIN' && (currentRole === 'MANAGER' || currentRole === 'OWNER')) || (item.role === 'MANAGER' && currentRole === 'OWNER'))}}"
      class="actions"
    >
      <button wx:if="{{item.role === 'MEMBER' && (currentRole === 'MANAGER' || currentRole === 'OWNER')}}" class="secondary-button button-md" data-id="{{item.id}}" data-role="ADMIN" disabled="{{processingId}}" bindtap="handleRole">设为管理员</button>
      <button wx:if="{{item.role === 'ADMIN' && (currentRole === 'MANAGER' || currentRole === 'OWNER')}}" class="secondary-button button-md" data-id="{{item.id}}" data-role="MEMBER" disabled="{{processingId}}" bindtap="handleRole">取消管理员</button>
      <button wx:if="{{item.role === 'ADMIN' && currentRole === 'OWNER'}}" class="secondary-button button-md" data-id="{{item.id}}" disabled="{{processingId}}" bindtap="handleAppoint">任命实际管理者</button>
      <button wx:if="{{item.role === 'MANAGER' && currentRole === 'OWNER'}}" class="secondary-button button-md" data-id="{{item.id}}" disabled="{{processingId}}" bindtap="handleRemoveManager">免去实际管理者</button>
      <button wx:if="{{item.role === 'ADMIN' && currentRole === 'MANAGER'}}" class="secondary-button button-md" data-id="{{item.id}}" disabled="{{processingId}}" bindtap="handleTransfer">传位给此管理员</button>
      <button wx:if="{{(currentRole === 'ADMIN' && item.role === 'MEMBER') || ((currentRole === 'MANAGER' || currentRole === 'OWNER') && item.role !== 'OWNER' && item.role !== 'MANAGER')}}" class="danger-outline-button button-md" data-id="{{item.id}}" loading="{{processingId === item.id}}" disabled="{{processingId}}" bindtap="handleDisable">移除成员</button>
    </view>
  </view>
  <view wx:if="{{errorMessage && members.length}}" class="error">{{errorMessage}}</view>
</view>
