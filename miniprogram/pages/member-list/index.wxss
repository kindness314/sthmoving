.heading {
  margin-bottom: 32rpx;
}

.title {
  margin-bottom: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.member-card {
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx;
}

.member-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.member-name {
  overflow: hidden;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role {
  flex: none;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
  color: #374151;
  font-size: 22rpx;
}

.role-OWNER,
.role-MANAGER {
  background: var(--brand-soft-color, #e8eef6);
  color: var(--brand-color, #17365d);
}

.meta {
  line-height: 1.6;
  font-size: 25rpx;
}

.actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.actions button {
  flex: 1 1 0;
  min-width: 0;
}

.state {
  padding: 48rpx 24rpx;
  text-align: center;
}

.error {
  margin-top: 20rpx;
  color: #b91c1c;
  text-align: center;
}

.setup-notice {
  margin-bottom: 24rpx;
  border-left: 8rpx solid var(--brand-color, #17365d);
  color: var(--brand-color, #17365d);
  line-height: 1.6;
}
