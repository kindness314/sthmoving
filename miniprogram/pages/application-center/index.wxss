.heading {
  margin-bottom: 28rpx;
}

.title {
  margin-bottom: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.empty {
  padding: 56rpx 24rpx;
  text-align: center;
}

.refreshing {
  margin: -12rpx 0 16rpx;
  font-size: 24rpx;
  text-align: right;
}

.request-card {
  margin-bottom: 20rpx;
}

.request-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.request-name {
  font-size: 32rpx;
  font-weight: 600;
}

.item-code {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.status {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fef3c7;
  color: #92400e;
  font-size: 23rpx;
}

.status-APPROVED {
  background: #ccfbf1;
  color: #0f766e;
}

.status-REJECTED {
  background: #fee2e2;
  color: #b91c1c;
}

.reason {
  margin-top: 20rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.request-time {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.review-comment {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f9fafb;
  color: #4b5563;
  font-size: 25rpx;
}

.error {
  color: #b91c1c;
  font-size: 26rpx;
  text-align: center;
}

.retry-button {
  margin-top: 20rpx;
}
