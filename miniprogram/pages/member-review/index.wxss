.heading {
  margin-bottom: 32rpx;
}

.title {
  margin-bottom: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.empty {
  padding: 48rpx 32rpx;
  text-align: center;
}

.request-card {
  margin-bottom: 24rpx;
}

.request-name {
  font-size: 34rpx;
  font-weight: 600;
}

.request-time {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 28rpx;
}

.actions button {
  margin: 0 0 0 20rpx;
}

.approve-button {
  background: #0f766e !important;
  color: #ffffff !important;
}

.reject-button {
  color: #b91c1c !important;
}

.error {
  margin-top: 24rpx;
  color: #b91c1c;
  font-size: 26rpx;
}
