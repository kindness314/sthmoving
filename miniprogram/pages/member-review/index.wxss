.heading {
  margin-bottom: 32rpx;
}

.title {
  margin-bottom: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.empty {
  padding: 48rpx 32rpx;
  text-align: center;
}

.request-card {
  margin-bottom: 24rpx;
}

.request-name {
  font-size: 34rpx;
  font-weight: 600;
}

.request-time {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.request-role {
  margin-top: 12rpx;
  color: #0f766e;
}

.actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
}

.actions button {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  height: 76rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 16rpx;
  line-height: 76rpx;
}

.approve-button {
  background: #0f766e !important;
  color: #ffffff !important;
}

.reject-button {
  color: #b91c1c !important;
}

.error {
  margin-top: 24rpx;
  color: #b91c1c;
  font-size: 26rpx;
}
