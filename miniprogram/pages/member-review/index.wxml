<view class="page" style="{{themeStyle}}">
  <nav-bar title="成员审核" />
  <view class="heading">
    <view class="title">待审核成员</view>
    <view class="muted">只显示当前尚未处理的加入申请</view>
  </view>

  <view wx:if="{{loading && !requests.length}}" class="card muted empty">
    正在加载…
  </view>
  <view wx:elif="{{!requests.length}}" class="card empty">
    暂无待审核申请
  </view>

  <view
    wx:for="{{requests}}"
    wx:key="id"
    class="card request-card"
  >
    <view class="request-heading">
      <view class="request-name">{{item.displayName}}</view>
      <view class="request-role">
        {{item.requestedRole === 'ADMIN' ? '申请管理员' : '申请普通成员'}}
      </view>
    </view>
    <view class="muted request-time">申请时间：{{item.createdAtText}}</view>
    <view class="actions">
      <button
        class="danger-outline-button button-md"
        data-id="{{item.id}}"
        data-decision="REJECT"
        disabled="{{processingId}}"
        bindtap="handleReview"
      >
        拒绝
      </button>
      <button
        class="primary-button button-md"
        data-id="{{item.id}}"
        data-decision="APPROVE"
        loading="{{processingId === item.id}}"
        disabled="{{processingId}}"
        bindtap="handleReview"
      >
        通过
      </button>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
  <text-entry-modal id="text-entry-modal" />
</view>
