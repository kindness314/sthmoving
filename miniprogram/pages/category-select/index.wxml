<view class="page">
  <view class="heading">
    <view class="title">物品分类</view>
    <view class="muted">预设分类不可删除，所有成员均可新建分类</view>
  </view>

  <view class="card create-card">
    <view class="field-label">新分类名称</view>
    <view class="create-row">
      <input
        class="text-input"
        maxlength="40"
        value="{{categoryName}}"
        placeholder="例如：活动器材"
        bindinput="handleNameInput"
      />
      <button
        class="primary-button create-button"
        size="mini"
        loading="{{creating}}"
        disabled="{{creating || !categoryName}}"
        bindtap="handleCreate"
      >
        新建
      </button>
    </view>
  </view>

  <view class="section-title">现有分类（{{categories.length}}）</view>
  <view wx:if="{{loading && !categories.length}}" class="muted empty">
    正在加载…
  </view>
  <view wx:elif="{{!categories.length}}" class="card empty">
    暂无分类
  </view>
  <view
    wx:for="{{categories}}"
    wx:key="id"
    class="card category-row"
  >
    <view>{{item.name}}</view>
    <view wx:if="{{item.isPreset}}" class="preset-badge">预设</view>
    <view wx:else class="custom-badge">自定义</view>
  </view>

  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
</view>
