.heading {
  margin-bottom: 32rpx;
}

.title {
  margin-bottom: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.create-card {
  margin-bottom: 40rpx;
}

.field-label {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.create-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.text-input {
  box-sizing: border-box;
  flex: 1;
  padding: 20rpx 24rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 16rpx;
}

.create-button {
  flex: none;
  margin: 0;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.category-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.preset-badge,
.custom-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.preset-badge {
  background: #ccfbf1;
  color: #0f766e;
}

.custom-badge {
  background: #f3f4f6;
  color: #4b5563;
}

.empty {
  padding: 48rpx 32rpx;
  text-align: center;
}

.error {
  margin-top: 24rpx;
  color: #b91c1c;
  font-size: 26rpx;
}
