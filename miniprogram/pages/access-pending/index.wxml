<view class="page pending-page">
  <view class="card">
    <view class="title">{{title}}</view>
    <view class="muted">{{description}}</view>
    <view wx:if="{{canApply}}" class="application-form">
      <view class="field-label">姓名或称呼</view>
      <input
        class="text-input"
        maxlength="40"
        value="{{displayName}}"
        placeholder="便于管理员确认身份"
        bindinput="handleDisplayNameInput"
      />
      <button
        class="primary-button submit-button"
        loading="{{submitting}}"
        disabled="{{submitting || !displayName}}"
        bindtap="handleSubmit"
      >
        提交加入申请
      </button>
    </view>
    <button
      wx:else
      class="retry-button"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="handleRetry"
    >
      刷新状态
    </button>
    <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
  </view>
</view>
