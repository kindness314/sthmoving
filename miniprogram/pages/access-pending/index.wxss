.pending-page {
  display: flex;
  flex-direction: column;
}

.card {
  width: 100%;
  margin-top: auto;
  margin-bottom: auto;
}

.title {
  margin-bottom: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.retry-button {
  margin-top: 40rpx;
  border-radius: 16rpx;
}

.application-form {
  margin-top: 40rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #26364e;
  font-size: 28rpx;
  font-weight: 600;
}

.text-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d7dee8;
  border-radius: 14rpx;
  background: #f8fafc;
  font-size: 30rpx;
  line-height: 86rpx;
}

.submit-button {
  margin: 32rpx 0 0;
}

.role-label {
  margin-top: 28rpx;
}

.role-options {
  display: flex;
  gap: 36rpx;
}

.role-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
}

.error {
  margin-top: 24rpx;
  color: #b91c1c;
  font-size: 26rpx;
}
