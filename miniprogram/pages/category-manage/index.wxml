<view class="page">
  <view class="heading">
    <view class="title">分类管理</view>
    <view class="muted">
      管理员可整理自定义分类；预设分类不可修改
    </view>
  </view>

  <view class="card create-card">
    <view class="field-label">新分类名称</view>
    <view class="create-row">
      <input
        class="text-input"
        maxlength="40"
        value="{{categoryName}}"
        placeholder="例如：活动器材"
        bindinput="handleNameInput"
      />
      <button
        class="primary-button create-button"
        size="mini"
        loading="{{creating}}"
        disabled="{{creating || !categoryName}}"
        bindtap="handleCreate"
      >
        新建
      </button>
    </view>
  </view>

  <view class="section-title">现有分类（{{categories.length}}）</view>
  <view wx:if="{{loading && !categories.length}}" class="muted empty">
    正在加载…
  </view>
  <view wx:elif="{{!categories.length}}" class="card empty">
    暂无分类
  </view>
  <view
    wx:for="{{categories}}"
    wx:key="id"
    class="card category-card {{item.status === 'DISABLED' ? 'disabled-category' : ''}}"
  >
    <view class="category-main">
      <view class="category-name">{{item.name}}</view>
      <view class="badges">
        <view wx:if="{{item.isPreset}}" class="preset-badge">预设</view>
        <view wx:else class="custom-badge">自定义</view>
        <view
          wx:if="{{item.status === 'DISABLED'}}"
          class="disabled-badge"
        >
          已停用
        </view>
      </view>
    </view>
    <view wx:if="{{!item.isPreset}}" class="category-actions">
      <button
        data-id="{{item.id}}"
        disabled="{{processingId}}"
        bindtap="handleRename"
      >
        重命名
      </button>
      <button
        class="{{item.status === 'ACTIVE' ? 'disable-button' : 'enable-button'}}"
        data-id="{{item.id}}"
        loading="{{processingId === item.id}}"
        disabled="{{processingId}}"
        bindtap="handleToggleStatus"
      >
        {{item.status === 'ACTIVE' ? '停用' : '启用'}}
      </button>
      <button
        class="delete-button"
        data-id="{{item.id}}"
        disabled="{{processingId}}"
        bindtap="handleDelete"
      >
        删除
      </button>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
  <text-entry-modal id="text-entry-modal" />
</view>
