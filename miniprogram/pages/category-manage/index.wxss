.heading {
  margin-bottom: 32rpx;
}

.title {
  margin-bottom: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.create-card {
  margin-bottom: 40rpx;
}

.field-label {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.create-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.text-input {
  box-sizing: border-box;
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 16rpx;
  line-height: 80rpx;
}

.create-button {
  flex: none;
  margin: 0;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.category-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.category-main {
  min-width: 0;
}

.category-name {
  font-size: 30rpx;
  font-weight: 500;
}

.badges {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.preset-badge,
.custom-badge,
.disabled-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.disabled-badge {
  background: #fef3c7;
  color: #92400e;
}

.disabled-category .category-name {
  color: #9ca3af;
}

.category-actions {
  display: flex;
  flex: none;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
  margin-left: 20rpx;
  max-width: 360rpx;
}

.category-actions button {
  margin: 0;
}

.disable-button {
  color: #b45309 !important;
}

.enable-button {
  color: #0f766e !important;
}

.delete-button {
  color: #b91c1c !important;
}

.preset-badge {
  background: #ccfbf1;
  color: #0f766e;
}

.custom-badge {
  background: #f3f4f6;
  color: #4b5563;
}

.empty {
  padding: 48rpx 32rpx;
  text-align: center;
}

.error {
  margin-top: 24rpx;
  color: #b91c1c;
  font-size: 26rpx;
}
