.heading {
  margin-bottom: 32rpx;
}

.title {
  margin-bottom: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.create-card {
  margin-bottom: 40rpx;
}

.field-label {
  margin-bottom: 16rpx;
  color: #26364e;
  font-size: 28rpx;
  font-weight: 600;
}

.create-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.text-input {
  box-sizing: border-box;
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d7dee8;
  border-radius: 14rpx;
  background: #f8fafc;
  line-height: 80rpx;
}

.create-button {
  flex: none;
  min-width: 132rpx;
  margin: 0;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.category-card {
  margin-bottom: 16rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.category-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-width: 0;
}

.category-name {
  min-width: 0;
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  word-break: break-all;
}

.badges {
  flex: none;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
}

.preset-badge,
.custom-badge,
.disabled-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.disabled-badge {
  background: #fef3c7;
  color: #92400e;
}

.disabled-category .category-name {
  color: #9ca3af;
}

.category-actions {
  display: flex;
  flex-wrap: nowrap;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #edf0f4;
}

.category-actions button {
  box-sizing: border-box;
  flex: 0 0 112rpx;
  width: 112rpx;
  min-width: 112rpx;
  height: 60rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 8rpx;
  background: transparent !important;
  font-size: 25rpx;
  line-height: 60rpx;
}

.category-actions button::after {
  border: none;
}

.rename-button {
  color: #475569 !important;
}

.disable-button {
  color: #b45309 !important;
}

.enable-button {
  color: var(--brand-color, #17365d) !important;
}

.delete-button {
  color: #b91c1c !important;
}

.preset-badge {
  background: var(--brand-soft-color, #e8eef6);
  color: var(--brand-color, #17365d);
}

.custom-badge {
  background: #f3f4f6;
  color: #4b5563;
}

.empty {
  padding: 48rpx 32rpx;
  line-height: 1.6;
  text-align: center;
}

.error {
  margin-top: 24rpx;
  color: #b91c1c;
  font-size: 26rpx;
}
