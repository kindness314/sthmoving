.heading {
  margin-bottom: 28rpx;
}

.title {
  margin-bottom: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.label-card,
.state {
  text-align: center;
}

.code-image {
  box-sizing: border-box;
  display: block;
  width: 560rpx;
  height: 560rpx;
  margin: 0 auto;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  background: #ffffff;
}

.ready-title,
.failed-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.failed-title {
  color: #b91c1c;
}

.code-text,
.hint,
.state-description {
  margin-top: 12rpx;
  font-size: 25rpx;
}

.state {
  padding: 64rpx 32rpx;
}

.generating-indicator {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 24rpx;
  border: 5rpx solid var(--brand-soft-color, #e8eef6);
  border-top-color: var(--brand-color, #17365d);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

.error {
  margin-top: 20rpx;
  color: #b91c1c;
  font-size: 26rpx;
}

.retry-button {
  margin-top: 28rpx;
}

.page-error {
  text-align: center;
}

.note-card {
  margin-top: 28rpx;
  line-height: 1.6;
}

.printer-card {
  margin-top: 28rpx;
}

.printer-header,
.copies-row,
.device-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.printer-status,
.control-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
}


.center-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 16rpx;
}

.center-row switch {
  transform: scale(0.8);
}
.label-size-control {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #e5e7eb;
}

.size-options {
  display: grid;
  gap: 16rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 16rpx;
}

.size-option {
  box-sizing: border-box;
  height: 72rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  background: #ffffff;
  color: #475569;
  font-size: 27rpx;
  line-height: 70rpx;
  text-align: center;
}

.size-option-active {
  border-color: var(--brand-color, #17365d);
  background: var(--brand-soft-color, #e8eef6);
  color: var(--brand-color, #17365d);
  font-weight: 600;
}

.status-dot {
  flex: 0 0 auto;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #9ca3af;
}

.status-READY {
  background: var(--brand-color, #17365d);
}

.status-DISCOVERING,
.status-CONNECTING,
.status-PRINTING {
  background: #d97706;
}

.copies-row {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #e5e7eb;
}

.control-label,
.device-name {
  font-weight: 600;
}

.copies-input {
  box-sizing: border-box;
  width: 160rpx;
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d7dee8;
  border-radius: 12rpx;
  background: #f8fafc;
  text-align: center;
}

.printer-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.printer-action {
  flex: 1;
  min-height: 84rpx;
  margin: 0;
  font-size: 28rpx;
  border-radius: 14rpx;
  line-height: 84rpx;
}

.secondary-action {
  border: 1rpx solid var(--brand-color, #17365d);
  background: #ffffff;
  color: var(--brand-color, #17365d);
}

.device-list {
  margin-top: 24rpx;
  border-top: 1rpx solid #e5e7eb;
}

.device-row {
  min-height: 104rpx;
  border-bottom: 1rpx solid #e5e7eb;
}

.device-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-connect {
  flex: 0 0 96rpx;
  min-height: 52rpx;
  margin: 0;
  font-size: 24rpx;
  border: none;
  border-radius: 10rpx;
  background: var(--brand-color, #17365d);
  color: #ffffff;
  line-height: 52rpx;
}

.search-hint,
.printer-error {
  margin-top: 24rpx;
  text-align: center;
  line-height: 1.5;
}

.print-button {
  min-height: 88rpx;
  margin: 28rpx 0 0;
  line-height: 88rpx;
}

.sdk-canvas-host {
  position: fixed;
  top: 0;
  left: -10000px;
  overflow: hidden;
  pointer-events: none;
}

.note-title {
  margin-bottom: 12rpx;
  font-weight: 600;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
