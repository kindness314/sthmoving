<view class="page">
  <view class="heading">
    <view class="title">物品小程序码</view>
    <view class="muted">{{item ? item.name : '正在读取物品信息'}}</view>
  </view>

  <view wx:if="{{loading && !label}}" class="state muted">
    正在加载小程序码…
  </view>

  <view wx:elif="{{generating}}" class="card state">
    <view class="generating-indicator"></view>
    <view>正在生成微信小程序码…</view>
    <view class="muted state-description">物品已经登记，请稍候</view>
  </view>

  <view wx:elif="{{label && label.status === 'READY'}}" class="card label-card">
    <image
      class="code-image"
      src="{{labelImageUrl}}"
      mode="aspectFit"
      bindtap="handlePreview"
    />
    <view class="ready-title">小程序码已生成</view>
    <view class="muted code-text">物品编码：{{label.publicCode}}</view>
    <view class="muted hint">点击图片可放大预览</view>
  </view>

  <view wx:elif="{{label && label.status === 'FAILED'}}" class="card state">
    <view class="failed-title">小程序码生成失败</view>
    <view class="error">
      {{label.errorMessage || '微信接口暂未生成小程序码'}}
    </view>
    <button
      class="primary-button retry-button"
      loading="{{generating}}"
      disabled="{{generating}}"
      bindtap="handleRetry"
    >
      重新生成
    </button>
  </view>

  <view wx:elif="{{label && label.status === 'VOID'}}" class="card state">
    <view class="failed-title">物品已离库</view>
    <view class="muted state-description">
      该小程序码已经作废，物品不再属于当前在库物品。
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="error page-error">
    {{errorMessage}}
  </view>

  <view wx:if="{{label && label.status === 'READY'}}" class="card printer-card">
    <view class="printer-header">
      <view>
        <view class="note-title">打印标签</view>
        <view class="muted printer-status">{{printerStatusText}}</view>
      </view>
      <view class="status-dot status-{{printerStatus}}"></view>
    </view>

    <view class="copies-row">
      <view>
        <view class="control-label">打印份数</view>
        <view class="muted control-hint">每次可打印 1-99 张</view>
      </view>
      <input
        class="copies-input"
        type="number"
        value="{{copiesInput}}"
        maxlength="2"
        bindinput="handleCopiesInput"
      />
    </view>

    <view class="printer-actions">
      <button
        wx:if="{{!discovering && printerStatus !== 'READY' && printerStatus !== 'PRINTING'}}"
        class="printer-action secondary-action"
        disabled="{{connectingDeviceId}}"
        bindtap="handleStartPrinterDiscovery"
      >
        搜索打印机
      </button>
      <button
        wx:if="{{discovering}}"
        class="printer-action secondary-action"
        bindtap="handleStopPrinterDiscovery"
      >
        停止搜索
      </button>
      <button
        wx:if="{{printerStatus === 'READY'}}"
        class="printer-action secondary-action"
        bindtap="handleDisconnectPrinter"
      >
        断开连接
      </button>
    </view>

    <view wx:if="{{printerDevices.length > 0 && printerStatus !== 'READY'}}" class="device-list">
      <view wx:for="{{printerDevices}}" wx:key="id" class="device-row">
        <view class="device-name">{{item.name}}</view>
        <button
          class="device-connect"
          data-device-id="{{item.id}}"
          loading="{{connectingDeviceId === item.id}}"
          disabled="{{connectingDeviceId}}"
          bindtap="handleConnectPrinter"
        >
          连接
        </button>
      </view>
    </view>

    <view wx:if="{{discovering && printerDevices.length === 0}}" class="muted search-hint">
      正在搜索，请确认打印机已开机并靠近手机
    </view>

    <view wx:if="{{printerErrorMessage}}" class="error printer-error">
      {{printerErrorMessage}}
    </view>

    <button
      class="primary-button print-button"
      loading="{{printing}}"
      disabled="{{printerStatus !== 'READY' || printing}}"
      bindtap="handlePrintLabel"
    >
      {{printing ? '正在打印' : '打印标签'}}
    </button>
  </view>

  <view class="card note-card">
    <view class="note-title">打印说明</view>
    <view class="muted">
      使用微信返回的原始 PNG，通过蓝牙打印到 30 × 30 mm 间隙标签纸。首次打印请先搜索并连接 T50 Pro。
    </view>
  </view>

  <view class="sdk-canvas-host">
    <canvas
      width="{{templateWidth * pixelRatio}}"
      height="{{templateHeight * pixelRatio}}"
      style="width:{{templateWidth}}px;height:{{templateHeight}}px"
      canvas-id="Canvas"
      id="Canvas"
    ></canvas>
    <canvas
      type="2d"
      style="width:{{barCodeWidth}}px;height:{{barCodeHeight}}px"
      canvas-id="barCodels"
      id="barCodels"
    ></canvas>
    <canvas
      type="2d"
      style="width:{{qrCodeWidth}}px;height:{{qrCodeHeight}}px"
      id="qrCode"
    ></canvas>
  </view>
</view>
