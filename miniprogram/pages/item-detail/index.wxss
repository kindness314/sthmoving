.images {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.detail-navigation {
  box-sizing: border-box;
  background: #0f766e;
  color: #ffffff;
}

.detail-navigation-row {
  position: relative;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back-button,
.nav-home-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
}

.nav-home-button {
  opacity: 0.96;
  border-radius: 0;
  background: transparent;
}

.nav-home-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  margin-top: 4rpx;
  border-radius: 0;
}

.nav-home-roof {
  position: absolute;
  width: 23rpx;
  height: 4rpx;
  background: #ffffff;
  transform-origin: left center;
}

.nav-home-roof-left {
  left: 4rpx;
  top: 18rpx;
  transform: rotate(-45deg);
}

.nav-home-roof-right {
  left: 20rpx;
  top: 2rpx;
  transform: rotate(45deg);
}

.nav-home-body {
  position: absolute;
  bottom: 1rpx;
  left: 7rpx;
  width: 26rpx;
  height: 22rpx;
  box-sizing: border-box;
  border-right: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  border-left: 3rpx solid #ffffff;
}

.nav-home-door {
  position: absolute;
  z-index: 1;
  bottom: 1rpx;
  left: 15rpx;
  width: 10rpx;
  height: 11rpx;
  box-sizing: border-box;
  border-top: 4rpx solid #ffffff;
  border-right: 4rpx solid #ffffff;
  border-left: 4rpx solid #ffffff;
}

.nav-title {
  position: absolute;
  left: 50%;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  white-space: nowrap;
  transform: translateX(-50%);
}

.nav-back-button {
  margin-right: 4rpx;
}

.nav-back-arrow {
  width: 22rpx;
  height: 22rpx;
  border-bottom: 4rpx solid #ffffff;
  border-left: 4rpx solid #ffffff;
  transform: rotate(45deg);
}

.item-image {
  min-width: 0;
  flex: 1;
  height: 320rpx;
  border-radius: 24rpx;
  background: #e5e7eb;
}

.summary-card,
.info-card {
  margin-bottom: 24rpx;
}

.summary-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.item-name {
  min-width: 0;
  font-size: 42rpx;
  font-weight: 700;
  word-break: break-all;
}

.status {
  flex: none;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #ccfbf1;
  color: #0f766e;
  font-size: 24rpx;
}

.status-OUTBOUND_PENDING {
  background: #fef3c7;
  color: #92400e;
}

.status-OFF_SHELF {
  background: #f3f4f6;
  color: #6b7280;
}

.code {
  margin-top: 16rpx;
  color: #6b7280;
  font-size: 25rpx;
}

.description {
  margin-top: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: 32rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 27rpx;
  line-height: 1.5;
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  flex: none;
  width: 170rpx;
  color: #6b7280;
  line-height: 1.5;
}

.info-value {
  min-width: 0;
  flex: 1;
  line-height: 1.5;
  text-align: right;
  word-break: break-all;
}

.review-card {
  margin-bottom: 24rpx;
}

.review-reason {
  margin-top: 16rpx;
  line-height: 1.6;
  word-break: break-all;
}

.review-actions,
.off-shelf-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.action-button {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  height: 76rpx;
  margin: 0;
  padding: 0 20rpx;
  line-height: 76rpx;
}

.state {
  padding: 64rpx 24rpx;
  text-align: center;
}

.error {
  color: #b91c1c;
}

.retry-button {
  margin-top: 20rpx;
}

.label-button {
  margin-top: 32rpx;
}

.secondary-button {
  border: 1rpx solid #0f766e;
  border-radius: 16rpx;
  background: #ffffff;
  color: #0f766e;
}

.logs-button {
  margin-top: 32rpx;
}

.edit-button {
  margin-top: 20rpx;
}

.outbound-button {
  margin-top: 20rpx;
}

.danger-button {
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: #b91c1c;
  color: #ffffff;
}
