.images {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.detail-navigation {
  position: sticky;
  z-index: 100;
  top: 0;
  box-sizing: border-box;
  background: var(--brand-color, #17365d);
  color: #ffffff;
}

.detail-navigation-row {
  position: relative;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back-button,
.nav-home-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
}

.nav-home-button {
  margin-left: 4rpx;
}

.nav-back-icon {
  width: 36rpx;
  height: 36rpx;
}

.nav-home-icon {
  width: 38rpx;
  height: 38rpx;
}

.nav-icon-button-active {
  opacity: 0.62;
}

.nav-title {
  position: absolute;
  left: 50%;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  white-space: nowrap;
  transform: translateX(-50%);
}

.item-image {
  min-width: 0;
  flex: 1;
  height: 320rpx;
  border-radius: 24rpx;
  background: #e5e7eb;
}

.summary-card,
.info-card {
  margin-bottom: 24rpx;
}

.summary-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.item-name {
  min-width: 0;
  font-size: 42rpx;
  font-weight: 700;
  word-break: break-all;
}

.status {
  flex: none;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--brand-soft-color, #e8eef6);
  color: var(--brand-color, #17365d);
  font-size: 24rpx;
}

.status-OUTBOUND_PENDING {
  background: #fef3c7;
  color: #92400e;
}

.status-OFF_SHELF {
  background: #f3f4f6;
  color: #6b7280;
}

.code {
  margin-top: 16rpx;
  color: #6b7280;
  font-size: 25rpx;
}

.description {
  margin-top: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: 32rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 27rpx;
  line-height: 1.5;
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  flex: none;
  width: 170rpx;
  color: #6b7280;
  line-height: 1.5;
}

.info-value {
  min-width: 0;
  flex: 1;
  line-height: 1.5;
  text-align: right;
  word-break: break-all;
}

.review-card {
  margin-bottom: 24rpx;
}

.review-reason {
  margin-top: 16rpx;
  line-height: 1.6;
  word-break: break-all;
}

.review-actions,
.off-shelf-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.review-actions .action-button,
.off-shelf-actions .action-button {
  margin: 0;
}

.action-button {
  flex: 1;
  min-width: 0;
}

.state {
  padding: 64rpx 24rpx;
  text-align: center;
}

.error {
  color: #b91c1c;
}

.retry-button {
  margin-top: 20rpx;
}

.label-button {
  margin-top: 32rpx;
}


.logs-button {
  margin-top: 32rpx;
}

.edit-button {
  margin-top: 20rpx;
}

.outbound-button {
  margin-top: 20rpx;
}

.danger-button {
  margin-top: 20rpx;
}
