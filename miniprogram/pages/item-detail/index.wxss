.images {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.item-image {
  min-width: 0;
  flex: 1;
  height: 320rpx;
  border-radius: 24rpx;
  background: #e5e7eb;
}

.summary-card,
.info-card {
  margin-bottom: 24rpx;
}

.summary-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.item-name {
  min-width: 0;
  font-size: 42rpx;
  font-weight: 700;
  word-break: break-all;
}

.status {
  flex: none;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #ccfbf1;
  color: #0f766e;
  font-size: 24rpx;
}

.status-OUTBOUND_PENDING {
  background: #fef3c7;
  color: #92400e;
}

.status-OFF_SHELF {
  background: #f3f4f6;
  color: #6b7280;
}

.code {
  margin-top: 16rpx;
  color: #6b7280;
  font-size: 25rpx;
}

.description {
  margin-top: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 32rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 27rpx;
  text-align: right;
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  flex: none;
  color: #6b7280;
}

.state {
  padding: 64rpx 24rpx;
  text-align: center;
}

.error {
  color: #b91c1c;
}

.retry-button {
  margin-top: 20rpx;
}

.label-button {
  margin-top: 32rpx;
}
