.heading {
  margin-bottom: 32rpx;
}

.title {
  margin-bottom: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.section {
  margin-bottom: 24rpx;
}

.field-label {
  margin-bottom: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.field-help {
  margin-bottom: 20rpx;
  font-size: 23rpx;
}

.reason-area {
  box-sizing: border-box;
  width: 100%;
  min-height: 240rpx;
  max-height: 360rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 16rpx;
  background: #ffffff;
  overflow-y: auto;
}

.error {
  margin: 8rpx 0 24rpx;
  color: #b91c1c;
  font-size: 26rpx;
}

.submit-button {
  margin-top: 32rpx;
}
