.heading {
  margin-bottom: 32rpx;
}

.title {
  margin-bottom: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.empty {
  padding: 48rpx 32rpx;
  line-height: 1.6;
  text-align: center;
}

.refreshing {
  margin: -16rpx 0 20rpx;
  font-size: 24rpx;
  text-align: right;
}

.request-card {
  margin-bottom: 24rpx;
}

.request-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.request-name {
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  word-break: break-all;
}

.status {
  flex: none;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #fef3c7;
  color: #92400e;
  font-size: 22rpx;
}

.meta,
.request-time {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.reason {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  line-height: 1.6;
  word-break: break-all;
}

.detail-button {
  width: 100%;
  margin: 18rpx 0 0;
}

.actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
}

.actions button {
  flex: 1;
  min-width: 0;
}

.error {
  margin-top: 24rpx;
  color: #b91c1c;
  font-size: 26rpx;
}

.retry-button {
  margin-top: 20rpx;
}
