.heading {
  margin-bottom: 32rpx;
}

.title {
  margin-bottom: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.section,
.conflict-card {
  margin-bottom: 24rpx;
}

.field-label {
  margin-bottom: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.field-help,
.conflict-help {
  margin-bottom: 20rpx;
  font-size: 23rpx;
}

.spaced-label {
  margin-top: 28rpx;
}

.text-input,
.text-area,
.summary-area,
.picker-input {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid #d1d5db;
  border-radius: 16rpx;
  background: #ffffff;
}

.picker-input {
  min-height: 80rpx;
  padding: 22rpx 24rpx;
  color: #374151;
  line-height: 36rpx;
}

.text-input {
  height: 80rpx;
  padding: 0 24rpx;
  line-height: 80rpx;
}

.text-area,
.summary-area {
  max-height: 360rpx;
  padding: 20rpx 24rpx;
  overflow-y: auto;
}

.text-area {
  min-height: 200rpx;
}

.summary-area {
  min-height: 140rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item,
.add-image {
  box-sizing: border-box;
  width: 200rpx;
}

.preview-image {
  display: block;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
}

.remove-image {
  width: 100%;
  margin: 12rpx 0 0;
  color: #b91c1c !important;
}

.add-image {
  height: 200rpx;
  margin: 0;
  border: 2rpx dashed #94a3b8;
  background: #f8fafc !important;
  color: #475569 !important;
  font-size: 27rpx;
  line-height: 196rpx;
}

.radio-group {
  display: flex;
  gap: 48rpx;
}

.radio-option {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.conflict-title {
  margin-bottom: 12rpx;
  color: #92400e;
  font-size: 32rpx;
  font-weight: 600;
}

.conflict-field {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f3f4f6;
}

.diff-row {
  display: flex;
  gap: 20rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  font-size: 25rpx;
}

.diff-row + .diff-row {
  margin-top: 10rpx;
}

.diff-changed {
  background: #fff7ed;
}

.diff-label {
  flex: none;
  color: #6b7280;
}

.diff-value {
  min-width: 0;
  flex: 1;
  white-space: pre-wrap;
  word-break: break-all;
}

.choice-row {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.choice-button {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  height: 72rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 16rpx;
  color: #374151;
  line-height: 72rpx;
}

.choice-selected {
  border-color: #0f766e;
  background: #ccfbf1 !important;
  color: #0f766e !important;
}

.continue-button,
.submit-button {
  margin-top: 28rpx;
}

.error {
  margin: 8rpx 0 24rpx;
  color: #b91c1c;
  font-size: 26rpx;
}

.state {
  padding: 64rpx 24rpx;
  text-align: center;
}

.retry-button {
  margin-top: 20rpx;
}
