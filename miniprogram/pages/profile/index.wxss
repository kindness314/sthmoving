.profile-page {
  --page-inset-top: 32rpx;
  padding-top: 32rpx;
  padding-bottom: calc(180rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.profile-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.heading {
  min-width: 0;
  flex: 1;
  margin-bottom: 0;
}

.identity-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  width: 132rpx;
  height: 132rpx;
  flex: none;
  border-radius: 50%;
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 700;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-edit {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 38rpx;
  background: rgba(15, 23, 42, 0.72);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 38rpx;
  text-align: center;
}

.identity-main {
  min-width: 0;
  flex: 1;
}

.identity-name {
  overflow: hidden;
  font-size: 38rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.role-badge,
.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.role-badge {
  background: var(--brand-soft-color, #e8eef6);
  color: var(--brand-color, #17365d);
}

.status-badge {
  background: #ecfdf5;
  color: #047857;
}

.form-card,
.theme-card,
.account-card {
  margin-top: 20rpx;
}

.section-title {
  margin-bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.info-row {
  display: grid;
  align-items: center;
  gap: 20rpx;
  grid-template-columns: 128rpx minmax(0, 1fr);
  min-height: 88rpx;
  border-bottom: 1rpx solid #edf0f4;
}

.info-content {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
}

.editable-value {
  display: grid;
  align-items: center;
  gap: 12rpx;
  grid-template-columns: minmax(0, 220rpx) auto;
  min-width: 0;
}

.editable-text {
  overflow: hidden;
  min-width: 0;
  line-height: 48rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.inline-picker {
  height: 48rpx;
}



.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: #64748b;
  font-size: 27rpx;
}

.info-value {
  color: #1e293b;
  font-size: 28rpx;
  text-align: left;
}

.theme-options {
  display: grid;
  gap: 14rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.theme-option {
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
  min-height: 76rpx;
  padding: 0 18rpx;
  border: 2rpx solid;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.theme-option-active {
  box-shadow: inset 0 0 0 2rpx currentColor;
}

.theme-swatch {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  border-radius: 50%;
}

.theme-check {
  margin-left: auto;
  color: var(--brand-color, #17365d);
  font-weight: 700;
}

.form-error {
  margin-top: 20rpx;
}

.state {
  padding: 64rpx 24rpx;
  text-align: center;
}

.error {
  color: #b91c1c;
}
