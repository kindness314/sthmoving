.scan-page {
  display: flex;
  flex-direction: column;
}

.scan-card {
  margin-top: 32rpx;
  padding: 72rpx 32rpx;
  text-align: center;
}

.scan-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  margin: 0 auto 32rpx;
  border-radius: 28rpx;
  background: var(--brand-soft-color, #e8eef6);
}

.scan-icon {
  width: 70rpx;
  height: 70rpx;
}

.scan-hint {
  color: #6b7280;
  font-size: 28rpx;
}

.scan-button {
  margin: 40rpx 0 0;
}

.error {
  margin-top: 24rpx;
  color: #b91c1c;
  text-align: center;
}
