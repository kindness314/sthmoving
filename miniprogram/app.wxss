page {
  min-height: 100%;
  background: #f6f7f9;
  color: #182027;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 32rpx;
}

.card {
  padding: 32rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 24rpx;
  background: #ffffff;
}

.primary-button {
  border-radius: 16rpx;
  background: #0f766e !important;
  color: #ffffff !important;
}

.muted {
  color: #6b7280;
}
