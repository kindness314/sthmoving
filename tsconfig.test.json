{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "types": ["node", "vitest/globals", "miniprogram-api-typings"],
    "noEmit": true
  },
  "include": [
    "miniprogram/**/*.ts",
    "miniprogram/**/*.d.ts",
    "cloudfunctions/api/src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
