{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "ES2024.Promise"
    ],
    "types": [
      "node",
      "vitest/globals",
      "miniprogram-api-typings"
    ],
    "noEmit": true
  },
  "include": [
    "miniprogram/**/*.ts",
    "miniprogram/**/*.d.ts",
    "cloudfunctions/api/src/**/*.ts",
    "server/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
