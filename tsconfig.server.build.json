{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "ES2024.Promise"],
    "types": ["node"],
    "esModuleInterop": true,
    "rootDir": ".",
    "outDir": "server/dist",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["server/src/**/*.ts"],
  "exclude": ["server/dist/**"]
}
